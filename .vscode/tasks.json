{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docs: serve",
      "type": "shell",
      "command": "uvx zensical==0.0.71 serve --open",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "worker: gates",
      "type": "shell",
      "command": "uv run ruff check && uv run ruff format --check && uv run mypy",
      "options": {
        "cwd": "${workspaceFolder}/apps/worker"
      },
      "problemMatcher": []
    },
    {
      "label": "api: check",
      "type": "shell",
      "command": "bun run check",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "problemMatcher": []
    },
    {
      "label": "api: dev",
      "type": "shell",
      "command": "bun run dev",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "problemMatcher": []
    },
    {
      "label": "infra: up",
      "type": "shell",
      "command": "docker compose -f infra/compose.dev.yaml --env-file infra/.env up -d",
      "problemMatcher": []
    }
  ]
}
