{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "check": "bun run typecheck && bun run format && bun run lint && bun run test",
    "typecheck": "bun check",
    "lint": "oxlint --type-aware --deny-warnings src test",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "test": "vitest run",
    "migration:generate": "typeorm-ts-node-esm migration:generate -d src/core/database/data-source.ts",
    "migration:run": "typeorm-ts-node-esm migration:run -d src/core/database/data-source.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/typeorm": "12.0.2",
    "dotenv": "18.0.8",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
